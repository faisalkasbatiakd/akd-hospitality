# Copy to .env.local and fill in. Nothing here is secret: every value is
# NEXT_PUBLIC_, so it ships in the browser bundle by design.

# Canonical origin, used for metadataBase, canonical URLs, robots.txt and the
# sitemap. No trailing slash, and no www - www should 301 to the apex so the
# two hosts do not compete for the same rankings.
NEXT_PUBLIC_SITE_URL=https://akdhospitality.com

# Where the 110 PDFs are served from. Defaults to /documents inside this repo.
# Point this at blob or object storage if the static payload ever needs to move
# off the deployment.
# NEXT_PUBLIC_DOCS_BASE_URL=/documents

# Contact form. Get a free access key from https://web3forms.com by entering
# info@akdhospitality.com and confirming the link sent to that inbox. Every
# submission is then emailed there. Without this the form still renders and
# validates, but submitting shows a notice asking the visitor to email us
# directly - it never silently drops a message.
NEXT_PUBLIC_WEB3FORMS_KEY=
